# AirSense configuration — copy to `.env` and fill in.
# Do NOT commit real credentials. On Windows you can also set these as
# system environment variables instead.

# --- MQTT broker (Mosquitto on the laptop, or a host IP) ------------------
MQTT_HOST=localhost
MQTT_PORT=1883
# Leave blank if the broker is open (no auth). If you enable auth in
# mosquitto.conf, set both:
# MQTT_USER=airsense
# MQTT_PASSWORD=changeit
MQTT_CLIENT_ID=airsense-backend
MQTT_TOPIC_PREFIX=airsense/group9/

# --- Device / data ---------------------------------------------------------
DEVICE_OFFLINE_TTL=30
# AIRSENSE_DATA_DIR=./data
# AIRSENSE_DB=./data/airsense.db

# --- Threshold defaults (uncalibrated ADC units) --------------------------
DEFAULT_MODERATE=100.0
DEFAULT_HIGH=150.0
DEFAULT_HYSTERESIS=5.0
DEFAULT_EWMA_ALPHA=0.30
